#version 430 core
layout(local_size_x=8,local_size_y=8)in;
uniform sampler2D u_cv;      // R8 texture: cv values (0=empty, 1=wire)
uniform ivec2 u_cs;          // W, H
uniform sampler2D u_fi;       // RGBA32F: complex fi (R=real, G=imag)

layout(std430, binding=0) buffer SpikeOut {
    int count;
    int pad0, pad1, pad2;
    uint data[];  // packed: (y<<22)|(x<<12)|(type<<8)|(re_idx), then imag_val
};

// Check if cv[x][y] matches expected value (0 or 1)
bool ck(ivec2 p, int exp) {
    if(p.x<0||p.x>=u_cs.x||p.y<0||p.y>=u_cs.y)return false;
    float v=texelFetch(u_cv,p,0).r;
    return (exp==0)?(v<0.5):(v>0.5);
}

void push(ivec2 pos, uint typ, float re, float im) {
    uint idx=atomicAdd(count,1);
    uint packed=(uint(pos.y)<<22)|(uint(pos.x)<<12)|(typ<<8)|(uint(re*1000+32768));
    data[idx*2]=packed; data[idx*2+1]=floatBitsToUint(im);
}

void reco_ln(ivec2 bp, int dir) {
    int x=bp.x,y=bp.y;
    switch(dir){
    case 0:
        if(ck(ivec2(x+0,y+0),1))break; if(!ck(ivec2(x+1,y+0),1))break; if(ck(ivec2(x+2,y+0),1))break;
        if(!ck(ivec2(x+0,y+1),1))break; if(!ck(ivec2(x+1,y+1),1))break; if(!ck(ivec2(x+2,y+1),1))break; if(!ck(ivec2(x+3,y+1),1))break;
        if(ck(ivec2(x+0,y+2),1))break; if(!ck(ivec2(x+1,y+2),1))break; if(ck(ivec2(x+2,y+2),1))break; if(ck(ivec2(x+3,y+2),1))break;
        if(ck(ivec2(x+0,y+3),1))break; if(!ck(ivec2(x+1,y+3),1))break; if(!ck(ivec2(x+2,y+3),1))break; if(!ck(ivec2(x+3,y+3),1))break; if(ck(ivec2(x+4,y+3),1))break;
        if(ck(ivec2(x+1,y+4),1))break; if(ck(ivec2(x+2,y+4),1))break; if(ck(ivec2(x+3,y+4),1))break;
        {vec4 f=texelFetch(u_fi,ivec2(x+2,y+1),0);float r=f.r,i=f.g;float re=log(sqrt(r*r+i*i));float im=atan(i,r);push(ivec2(x+2,y+3),0,re,im);}break;
    case 1:
        if(ck(ivec2(x+3,y+0),1))break; if(!ck(ivec2(x+1,y+1),1))break; if(ck(ivec2(x+2,y+1),1))break; if(!ck(ivec2(x+3,y+1),1))break; if(ck(ivec2(x+4,y+1),1))break;
        if(ck(ivec2(x+0,y+2),1))break; if(!ck(ivec2(x+1,y+2),1))break; if(ck(ivec2(x+2,y+2),1))break; if(!ck(ivec2(x+3,y+2),1))break; if(ck(ivec2(x+4,y+2),1))break;
        if(!ck(ivec2(x+0,y+3),1))break; if(!ck(ivec2(x+1,y+3),1))break; if(!ck(ivec2(x+2,y+3),1))break; if(!ck(ivec2(x+3,y+3),1))break; if(ck(ivec2(x+4,y+3),1))break;
        if(ck(ivec2(x+0,y+4),1))break; if(!ck(ivec2(x+1,y+4),1))break; if(ck(ivec2(x+2,y+4),1))break; if(ck(ivec2(x+3,y+4),1))break;
        {vec4 f=texelFetch(u_fi,ivec2(x+1,y+2),0);float r=f.r,i=f.g;push(ivec2(x+3,y+2),0,log(sqrt(r*r+i*i)),atan(i,r));}break;
    // ... remaining 6 ln directions + 4 exp directions
    // (truncated for brevity - full version in the actual write)
    }
}

void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(p.x>=u_cs.x-5||p.y>=u_cs.y-5)return;
    for(int d=0;d<8;d++)reco_ln(p,d);
    // for(int d=0;d<4;d++)reco_exp(p,d);
}
